# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Put these two in .env: the Prisma CLI does not read .env.local
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.xxxx:password@aws-0-eu-west-3.pooler.supabase.com:5432/postgres

APP_URL=http://localhost:3000

# Payments
PAYMENT_TIMEOUT_MINUTES=15
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Wave (https://docs.wave.com/business)
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=

# Orange Money WebPay (https://developer.orange.com)
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=
ORANGE_MERCHANT_KEY=
ORANGE_COUNTRY=ml
ORANGE_CURRENCY=XOF

# Demo (portfolio): one-tap anonymous login + test operator
DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true
# Generate with: openssl rand -hex 32  (the app refuses to start in demo mode with a weak secret)
SANDBOX_WEBHOOK_SECRET=
SANDBOX_TIMEOUT_MINUTES=2

# Seed: your Supabase auth user id, so the demo circles belong to you
SEED_ME_ID=
